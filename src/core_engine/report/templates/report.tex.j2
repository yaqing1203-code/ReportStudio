\toprule
<< ("样品与指标" if locale == "zh" else "Specimen / metric") | tex >> & << ("观测值" if locale == "zh" else "Observation") | tex >> & << ("明确条件" if locale == "zh" else "Explicit conditions") | tex >> & << ("比较所缺条件" if locale == "zh" else "Missing comparison conditions") | tex >> \\
