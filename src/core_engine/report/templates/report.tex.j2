%% Formal report template — core-engine report pipeline.
%% Rendered by report/latex.py (Jinja2 with custom delimiters so it never
%% collides with LaTeX's own {{ }} / {% %}). Compiled by scripts/compile.py.
%%
%% Design goals: formal business/academic standard — clean typography, generous
%% margins, running headers, professional title block, well-formatted source table.
%% Engine: xelatex (Unicode + system fonts). Falls back to pdflatex-safe packages.
\documentclass[11pt,a4paper]{article}

<% if locale == "zh" %>
%% --- Chinese locale: ctex provides CJK fonts/typography (xelatex/xeCJK) --------
\usepackage{ctex}
<% endif %>

%% --- Encoding / fonts (xelatex-friendly, pdflatex-safe fallback) -------------
\usepackage{iftex}
\ifPDFTeX
  \usepackage[utf8]{inputenc}
  \usepackage[T1]{fontenc}
  \usepackage{lmodern}
\else
  \usepackage{fontspec}
\fi

%% --- Layout ------------------------------------------------------------------
\usepackage[a4paper,margin=1in,headheight=14pt]{geometry}
\usepackage{microtype}          % refined justification / kerning
\usepackage{setspace}
\onehalfspacing
\usepackage{parskip}            % space between paragraphs, no indent
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{booktabs}           % professional tables (\toprule etc.)
\usepackage{longtable}          % multi-page source table
\usepackage{array}
\usepackage{xcolor}
\usepackage{graphicx}
\usepackage{float}
%% --- Charts: TikZ (chain flowchart) + pgfplots (market/share charts) ---------
\usepackage{tikz}
\usetikzlibrary{arrows.meta, positioning, shapes.geometric, fit, backgrounds}
\usepackage{pgfplots}
\pgfplotsset{compat=1.17}
\usepackage{xurl}
\usepackage{hyperref}
\usepackage{enumitem}

%% --- Colours / links ---------------------------------------------------------
\definecolor{primary}{RGB}{28,52,94}      % deep navy
\definecolor{accent}{RGB}{120,130,145}    % muted slate
\hypersetup{
  colorlinks=true, linkcolor=primary, urlcolor=primary, citecolor=primary,
  pdftitle={<< title | tex >>}, pdfauthor={core-engine report pipeline}
}

%% --- Section styling ---------------------------------------------------------
\titleformat{\section}{\Large\bfseries\color{primary}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\large\bfseries\color{primary}}{\thesubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.6em}

%% --- Running header / footer -------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{accent}<< title | truncate(60) | tex >>}
\fancyhead[R]{\small\color{accent}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{accent}\leaders\hrule height \headrulewidth\hfill}}

\begin{document}

%% --- Title block -------------------------------------------------------------
\begin{titlepage}
  \centering
  \vspace*{2cm}
  {\color{accent}\large\scshape << (("研究报告 · 待复核草稿" if quality_status == "needs_review" else "研究报告") if locale == "zh" else ("Research Report / Review Draft" if quality_status == "needs_review" else "Research Report")) | tex >>\par}
  \vspace{1.2cm}
  {\color{primary}\Huge\bfseries << title | tex >>\par}
  \vspace{0.6cm}
  {\color{accent}\rule{0.5\textwidth}{0.8pt}\par}
<% if source_quality.evidence_mode == "limited_evidence" %>
  \vspace{0.4cm}
  {\color{primary}\large\bfseries << ("有限证据报告 · 尚未独立证实" if locale == "zh" else "Limited Evidence Report — Not Independently Confirmed") | tex >>\par}
<% endif %>
  \vspace{1.5cm}
  \begin{minipage}{0.8\textwidth}
    \centering\itshape\large << abstract | tex >>
  \end{minipage}
  \vfill
  {\color{accent}\small Generated << generated_at | tex >> \\
   Compiled from << source_count >> source(s). See the source list and
   evidence limitations for the actual coverage.\par}
  \vspace{1cm}
\end{titlepage}

%% --- Provenance notice -------------------------------------------------------
\thispagestyle{fancy}
\section*{Methodology \& Provenance}
This report was assembled by an automated pipeline using << source_count >>
source(s), listed in the bibliography. Source count does not establish diversity
or independence; the evidence assessment records the access scope and limitations.
The configured strategy is \emph{<< verify_strategy | tex >>}.
<% if verify_strategy == "cross_reference" %>
Claims were checked for source support under the \emph{<< verify_mode | tex >>}
contract (up to << verify_rounds >> rounds). Confidence varies by claim; a
high-trust source can qualify without independent corroboration. Agreement among
sources is evidence of support, not proof that a statement is true.
<% else %>
Claims were accepted from extraction and screened for conflicts.
<% if verify_strategy == "aligned" %>
Entity alignment, source comparison and isolated-claim review add provenance signals.
<% endif %>
This strategy does not independently check every claim against its source text.
Source authority and the absence of a detected conflict do not establish truth.
<% endif %>
The structured sections link their knowledge-graph elements to cited claims.
Review the cited sources and any limitations before relying on the findings.

\tableofcontents
\newpage

<% if quality_status != "not_audited" %>
\section*{Sentence Evidence Audit}
Status: \textbf{<< quality_status | tex >>}.
<< grounding_audit.supported_sentences >> source-supported sentence(s);
<< grounding_audit.withheld_sentences >> draft sentence(s) withheld for review.
Source support does not establish factual truth or source independence.
<% if grounding_audit.chart_blocks_requiring_review %>
Some proposed charts/tables were withheld because numerical or scope validation failed.
<% endif %>
<% endif %>

<% if source_quality.evidence_mode == "limited_evidence" %>
\section*{<< ("有限证据报告" if locale == "zh" else "Limited Evidence Report") | tex >>}
<< ("现有资料未达到通常的来源数量或论点数量要求。本报告只保留能定位原文的说法，不代表已获得独立证实。缺失数据和未回答的问题仍须补证；摘要、预印本、材料或小电池实验不能证明量产、整电池性能或商业化。" if locale == "zh" else "Available evidence falls below the usual source or claim count. Only source-bound statements are retained; they are not independently confirmed. Gaps remain open. Abstracts, preprints and materials/coin-cell tests do not establish commercial or full-cell performance.") | tex >>
<% endif %>

%% --- Body: the 5 mandated sections; prose, KG-driven charts, then deep dives --
<% for section in sections %>
\section{<< section.heading | tex >>}
<% set visible_sentences = section.sentences | rejectattr("status", "equalto", "withheld") | list %>
<% if visible_sentences %>
<% for sentence in visible_sentences %>
<% if source_quality.evidence_mode == "limited_evidence" and sentence.status == "supported" and not sentence.attribution %>
\emph{<< ("来源报告（未独立证实）：" if locale == "zh" else "Source-reported (not independently confirmed): ") | tex >>}
<% endif %>
<< sentence.attribution | tex >><< sentence.text | tex >><% for eid in sentence.citation_ids %> \allowbreak{}\hyperref[ev:<< eid | tex >>]{[<< eid | tex >>]}<% endfor %>

<% endfor %>
<% elif not section.sentences and section.paragraphs %>
<% for para in section.paragraphs %>
<< para | tex >>

<% endfor %>
<% elif not section.latex_blocks and not section.deep_dives %>
<< ("本节暂无足够的原文支持内容。" if locale == "zh" else "This section has no sufficiently supported content yet.") | tex >>
<% endif %>
<% for block in section.latex_blocks %>
%% chart/table block — figure floats [H] so long sections don't push it adrift
\begin{figure}[H]
\centering
<< block >>
\end{figure}

<% endfor %>
<% if section.deep_dives %>
%% Deep-dive analytical insights (multi-paragraph, grounded in verified claims)
<% for dive in section.deep_dives %>
\subsection{<< dive.title | tex >>}
<% set visible_dive_sentences = dive.sentences | rejectattr("status", "equalto", "withheld") | list %>
<% if visible_dive_sentences %>
<% for sentence in visible_dive_sentences %>
<< sentence.attribution | tex >><< sentence.text | tex >><% for eid in sentence.citation_ids %> \allowbreak{}\hyperref[ev:<< eid | tex >>]{[<< eid | tex >>]}<% endfor %>

<% endfor %>
<% elif not dive.sentences and dive.paragraphs %>
<% for para in dive.paragraphs %>
<< para | tex >>

<% endfor %>
<% else %>
<< ("本节暂无足够的原文支持内容。" if locale == "zh" else "This section has no sufficiently supported content yet.") | tex >>
<% endif %>
<% endfor %>
<% endif %>
<% endfor %>

<% if scientific_audit and scientific_audit.observations %>
