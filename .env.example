# ReportStudio configuration — copy to .env and fill in what you need.
# All settings are read by core_engine.config.Settings (prefix CE_).
# The desktop app also persists GUI-saved settings separately; .env is the CLI default.

# ============================ LLM ============================
# Which LLM backend to use: "anthropic" | "openai" | "fake" (fake = offline tests)
CE_LLM_PROVIDER=anthropic
# API key for the Anthropic provider
CE_ANTHROPIC_API_KEY=
# Base URL for an OpenAI-compatible endpoint (used when provider is "openai")
CE_LLM_BASE_URL=
# Generic LLM API key (used by the "openai"-compatible provider)
CE_LLM_API_KEY=
# Model name passed to the provider
#CE_LLM_MODEL=claude-opus-4-8
# Global cap on concurrent LLM requests (429 / rate-limit guard)
#CE_LLM_MAX_CONCURRENCY=4
# Hard per-call timeout in seconds
#CE_LLM_TIMEOUT_S=120

# ====================== Search backends ======================
# Default search backend: "duckduckgo" (keyless) | "tavily" | "firecrawl" | "jina" | "fake"
CE_SEARCH_PROVIDER=duckduckgo
# API key for the search provider (required for tavily)
CE_SEARCH_API_KEY=
# Optional alternative primary providers (used only when explicitly selected).
# Firecrawl API key
CE_FIRECRAWL_API_KEY=
# Jina Reader API key (OPTIONAL — jina works keyless, a key just loosens rate limits)
CE_JINA_API_KEY=
# Respect robots.txt when fetching pages (true/false)
#CE_SCRAPE_RESPECT_ROBOTS=true
# If robots.txt cannot be fetched: true = allow the fetch, false = skip the page
#CE_SCRAPE_ROBOTS_FAIL_OPEN=true

# ==================== Search router & cache ==================
# Use the configured primary provider plus at most one fallback. OpenAlex remains
# an on-demand complement. false = pin the single-provider behavior.
#CE_SEARCH_ROUTER_ENABLED=true
# On-disk search-result cache TTL in seconds (0 disables caching)
#CE_SEARCH_CACHE_TTL_S=86400
# Source ranking weights: relevance / credibility (L1-L4) / freshness
#CE_RANK_W_RELEVANCE=0.5
#CE_RANK_W_SOURCE=0.35
#CE_RANK_W_FRESHNESS=0.15

# ================== Verification & alignment =================
# Verification strategy: "aligned" (default) | "conflict_only" | "cross_reference"
# Every strategy requires source passages before publication; candidates are not presumed true.
# Source-reported statements carry attribution; unresolved conflicts cannot drive calculations.
#CE_VERIFY_STRATEGY=aligned
# Verification mode: "traceable" | "strict"
#CE_VERIFY_MODE=traceable
# Model attention score (0-1); raises review flags without changing source credibility
#CE_ALIGNMENT_DEVIATION_THRESHOLD=0.6
# Active verification: one bounded round of proxy-metric re-search for isolated claims
#CE_ACTIVE_VERIFY_ENABLED=true
#CE_ACTIVE_VERIFY_MAX_QUERIES=3
# Human-in-the-loop: pause for confirmation when core isolated claims survive (default off)
#CE_HITL_ON_ISOLATED_CORE_CLAIM=false
# Verification stage wall-clock deadline in seconds
#CE_VERIFY_DEADLINE_S=360

# =========================== Report ==========================
# Report language: "en" | "zh" (zh localizes headings and switches LaTeX to ctex)
#CE_REPORT_LOCALE=en
# Final sentence-to-source audit budget (seconds). Unsupported drafts are withheld.
#CE_GROUNDING_DEADLINE_S=180
# Question-led research and bounded supplemental retrieval (never in document-only mode)
#CE_RESEARCH_ENABLED=true
#CE_RESEARCH_MAX_QUESTIONS=6
#CE_RESEARCH_MAX_ROUNDS=3
#CE_RESEARCH_MAX_QUERIES=6
#CE_RESEARCH_DEADLINE_S=240
#CE_RESEARCH_PLAN_TIMEOUT_S=15
#CE_RESEARCH_COVERAGE_TIMEOUT_S=45
# Follow OA locations from fetched scholarly records, within the same research/page budget.
#CE_RESEARCH_FULLTEXT_ENABLED=true
#CE_RESEARCH_FULLTEXT_MAX_DOCUMENTS=6
#CE_RESEARCH_FULLTEXT_LOCATIONS_PER_WORK=3
#CE_RESEARCH_FULLTEXT_TIMEOUT_S=60
# Maximum additional local passage reads for concrete gaps; shares the research deadline/claim budget.
#CE_RESEARCH_LOCAL_MAX_CHUNKS=6
#CE_SCRAPE_MAX_DOWNLOAD_BYTES=15728640
# Source-bound analytical judgments and a separate critical review pass
#CE_REASONING_ENABLED=true
#CE_REASONING_MAX_FINDINGS=4
#CE_REASONING_DEADLINE_S=45
# Sparse topics: preserve traceable evidence with explicit limits, not fabricated corroboration
#CE_SPARSE_EVIDENCE_ENABLED=true
# Crossref scholarly discovery; optional contact for the polite pool
#CE_SCHOLARLY_SEARCH_ENABLED=true
#CE_SCHOLARLY_MAILTO=
# OpenAlex complements academic/evidence-gap queries or a primary route without results.
# The optional key is sent only in Authorization headers, never stored in evidence URLs.
#CE_OPENALEX_SEARCH_ENABLED=true
#CE_OPENALEX_API_KEY=
#CE_OPENALEX_MAX_RESULTS=6
#CE_OPENALEX_TIMEOUT_S=12
# MiniMax M3 only: provider_default | adaptive | disabled (M3.1 Flash cannot disable thinking).
#CE_LLM_THINKING_MODE=provider_default
# Claim extraction budgets; omissions are recorded, not treated as complete coverage.
#CE_EXTRACTION_MAX_CLAIMS_PER_SOURCE=12
#CE_EXTRACTION_MAX_CLAIMS=120
# Read diverse original windows (methods/results/limitations), bounded by the same per-source claim cap.
#CE_EXTRACTION_MAX_CHUNKS_PER_SOURCE=3
# Optional global spacing across LLM requests/retries (0 disables spacing).
#CE_LLM_MIN_INTERVAL_S=0
# Public-DoH verification only when local DNS returns all proxy benchmark/Fake-IP addresses
#CE_PUBLIC_DNS_FALLBACK=true
# Append the synthesis-layer sections (source_comparison + limitations)
#CE_ENABLE_SYNTHESIS_SECTIONS=true
# LaTeX engine: "auto" | "tectonic" | "xelatex" | "pdflatex" | "latexmk"
#CE_LATEX_ENGINE=auto
# Where generated reports (.tex/.pdf) are written
#CE_OUTPUT_DIR=output

# ======================== Desktop app ========================
# Fixed port for the local backend (default: random free port)
#CE_APP_PORT=8765
# Loopback session token. Normally generated per launch by the desktop shell — when
# set, every /api/* request must present it (?token= or X-Session-Token header).
# Only set this by hand for CLI-run servers.
#CE_APP_SESSION_TOKEN=
