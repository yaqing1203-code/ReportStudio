# ReportStudio configuration — copy to .env and fill in what you need.
# All settings are read by core_engine.config.Settings (prefix CE_).
# The desktop app also persists GUI-saved settings separately; .env is the CLI default.

# ============================ LLM ============================
# Which LLM backend to use: "anthropic" | "openai" | "fake" (fake = offline tests)
CE_LLM_PROVIDER=anthropic
# API key for the Anthropic provider
CE_ANTHROPIC_API_KEY=
# Base URL for an OpenAI-compatible endpoint (used when provider is "openai")
CE_LLM_BASE_URL=
# Generic LLM API key (used by the "openai"-compatible provider)
CE_LLM_API_KEY=
# Model name passed to the provider
#CE_LLM_MODEL=claude-opus-4-8
# Global cap on concurrent LLM requests (429 / rate-limit guard)
#CE_LLM_MAX_CONCURRENCY=4
# Hard per-call timeout in seconds
#CE_LLM_TIMEOUT_S=120

# ====================== Search backends ======================
# Default search backend: "duckduckgo" (keyless) | "tavily" | "firecrawl" | "jina" | "fake"
CE_SEARCH_PROVIDER=duckduckgo
# API key for the search provider (required for tavily)
CE_SEARCH_API_KEY=
# Firecrawl API key (extraction-oriented backend; preferred for structured/table queries)
CE_FIRECRAWL_API_KEY=
# Jina Reader API key (OPTIONAL — jina works keyless, a key just loosens rate limits)
CE_JINA_API_KEY=
# Respect robots.txt when fetching pages (true/false)
#CE_SCRAPE_RESPECT_ROBOTS=true
# If robots.txt cannot be fetched: true = allow the fetch, false = skip the page
#CE_SCRAPE_ROBOTS_FAIL_OPEN=true

# ==================== Search router & cache ==================
# Route each query through the Search Router (query-type classification + per-type
# backend fallback chains). false = pin the legacy single-provider behavior.
#CE_SEARCH_ROUTER_ENABLED=true
# On-disk search-result cache TTL in seconds (0 disables caching)
#CE_SEARCH_CACHE_TTL_S=86400
# Source ranking weights: relevance / credibility (L1-L4) / freshness
#CE_RANK_W_RELEVANCE=0.5
#CE_RANK_W_SOURCE=0.35
#CE_RANK_W_FRESHNESS=0.15

# ================== Verification & alignment =================
# Verification strategy: "aligned" (default) | "conflict_only" | "cross_reference"
#CE_VERIFY_STRATEGY=aligned
# Verification mode: "traceable" | "strict"
#CE_VERIFY_MODE=traceable
# Baseline-deviation score (0-1) above which an isolated claim is downgraded one level
#CE_ALIGNMENT_DEVIATION_THRESHOLD=0.6
# Active verification: one bounded round of proxy-metric re-search for isolated claims
#CE_ACTIVE_VERIFY_ENABLED=true
#CE_ACTIVE_VERIFY_MAX_QUERIES=3
# Human-in-the-loop: pause for confirmation when core isolated claims survive (default off)
#CE_HITL_ON_ISOLATED_CORE_CLAIM=false
# Verification stage wall-clock deadline in seconds
#CE_VERIFY_DEADLINE_S=360

# =========================== Report ==========================
# Report language: "en" | "zh" (zh localizes headings and switches LaTeX to ctex)
#CE_REPORT_LOCALE=en
# Append the synthesis-layer sections (source_comparison + limitations)
#CE_ENABLE_SYNTHESIS_SECTIONS=true
# LaTeX engine: "auto" | "tectonic" | "xelatex" | "pdflatex" | "latexmk"
#CE_LATEX_ENGINE=auto
# Where generated reports (.tex/.pdf) are written
#CE_OUTPUT_DIR=output

# ======================== Desktop app ========================
# Fixed port for the local backend (default: random free port)
#CE_APP_PORT=8765
# Loopback session token. Normally generated per launch by the desktop shell — when
# set, every /api/* request must present it (?token= or X-Session-Token header).
# Only set this by hand for CLI-run servers.
#CE_APP_SESSION_TOKEN=
